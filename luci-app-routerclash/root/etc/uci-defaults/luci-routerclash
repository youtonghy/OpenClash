#!/bin/bash
. /lib/functions.sh
. /usr/share/routerclash/uci.sh

#Migrate from luci-app-openclash. Removing that package leaves a copy of its data in
#/etc/.openclash-upgrade (prerm) and deletes the originals (postrm); a copy is taken here when
#the originals are still around without the package. The copy goes to /etc/.routerclash-upgrade
#under the new names and is restored by the "Restore" step below.
if [ ! -e "/etc/init.d/openclash" ]; then
	RC_LEGACY_DIR="/etc/.openclash-upgrade"
	if [ ! -f "$RC_LEGACY_DIR/config" ] && [ -f "/etc/config/openclash" ]; then
		mkdir -p "$RC_LEGACY_DIR"
		cp -f "/etc/config/openclash" "$RC_LEGACY_DIR/config"
		[ -d "/etc/openclash" ] && cp -rf "/etc/openclash" "$RC_LEGACY_DIR/openclash"
		[ -d "/usr/share/openclash/ui" ] && cp -rf "/usr/share/openclash/ui" "$RC_LEGACY_DIR/ui"
	fi
	if [ -f "$RC_LEGACY_DIR/config" ] && [ ! -f "/etc/.routerclash-upgrade/config" ]; then
		RC_MIGRATE_DIR="/etc/.routerclash-upgrade"
		rm -rf "$RC_MIGRATE_DIR"
		mkdir -p "$RC_MIGRATE_DIR"
		mv -f "$RC_LEGACY_DIR/config" "$RC_MIGRATE_DIR/config"
		[ -d "$RC_LEGACY_DIR/openclash" ] && mv -f "$RC_LEGACY_DIR/openclash" "$RC_MIGRATE_DIR/routerclash"
		[ -d "$RC_LEGACY_DIR/ui" ] && mv -f "$RC_LEGACY_DIR/ui" "$RC_MIGRATE_DIR/ui"
		for f in "$RC_MIGRATE_DIR"/routerclash/custom/openclash_custom_*; do
			[ -e "$f" ] && mv -f "$f" "${f%/*}/routerclash_custom_${f##*/openclash_custom_}"
		done
		[ -f "$RC_MIGRATE_DIR/routerclash/rule_provider/oc-cn-domain.mrs" ] && \
			mv -f "$RC_MIGRATE_DIR/routerclash/rule_provider/oc-cn-domain.mrs" "$RC_MIGRATE_DIR/routerclash/rule_provider/rc-cn-domain.mrs"
		#paths, file names and UCI keys in the settings and in user-written files. The left-hand
		#guard keeps URLs such as .../root/etc/openclash/overwrite/default (upstream modules) intact.
		RC_PATHS='s#(^|[^A-Za-z0-9_.-])/(tmp/etc|var/etc|etc/init\.d|etc|usr/share|tmp)/openclash#\1/\2/routerclash#g; s#openclash_custom_#routerclash_custom_#g; s#oc-cn-domain#rc-cn-domain#g'
		RC_KEYS='s#(^|[^A-Za-z0-9_./-])openclash\.#\1routerclash.#g'
		sed -i -E "$RC_PATHS; $RC_KEYS; s#^config openclash #config routerclash #" "$RC_MIGRATE_DIR/config"
		for d in custom overwrite; do
			[ -d "$RC_MIGRATE_DIR/routerclash/$d" ] && find "$RC_MIGRATE_DIR/routerclash/$d" -type f -exec sed -i -E "$RC_PATHS; $RC_KEYS" {} +
		done
		[ -d "$RC_MIGRATE_DIR/routerclash/config" ] && find "$RC_MIGRATE_DIR/routerclash/config" -type f \( -name '*.yaml' -o -name '*.yml' \) -exec sed -i -E "$RC_PATHS" {} +
	fi
	#leftovers of the old package: data, firewall includes, kill switch, sysupgrade list
	rm -rf "$RC_LEGACY_DIR" "/etc/openclash" "/etc/config/openclash" "/usr/share/openclash" "/lib/upgrade/keep.d/luci-app-openclash" >/dev/null 2>&1
	uci -q delete firewall.openclash
	uci -q delete firewall.openclash_ks
	[ -e "/etc/config/ucitrack" ] && uci -q delete ucitrack.@openclash[-1]
	nft delete table inet oc_killswitch >/dev/null 2>&1
	for ipt in iptables ip6tables; do
		command -v $ipt >/dev/null 2>&1 || continue
		$ipt -w -S FORWARD 2>/dev/null | grep -- "-j oc_killswitch\$" | sed 's/^-A /-D /' | while read -r rule; do
			eval "$ipt -w $rule" 2>/dev/null
		done
		$ipt -w -F oc_killswitch 2>/dev/null
		$ipt -w -X oc_killswitch 2>/dev/null
	done
fi

[ -e "/etc/config/ucitrack" ] && {
uci -q delete ucitrack.@routerclash[-1]
uci -q add ucitrack routerclash
uci -q set ucitrack.@routerclash[-1].init=routerclash
uci -q commit ucitrack
}
uci -q delete firewall.routerclash
uci -q set firewall.routerclash=include
uci -q set firewall.routerclash.type=script
uci -q set firewall.routerclash.path=/var/etc/routerclash.include
[ -n "$(command -v fw4)" ] || uci -q set firewall.routerclash.reload=1
uci -q delete firewall.routerclash_ks
uci -q set firewall.routerclash_ks=include
uci -q set firewall.routerclash_ks.type=script
uci -q set firewall.routerclash_ks.path=/usr/share/routerclash/routerclash_killswitch.sh
uci -q set firewall.routerclash_ks.fw4_compatible=1
[ -n "$(command -v fw4)" ] || uci -q set firewall.routerclash_ks.reload=1
uci -q commit firewall

mkdir -p /etc/routerclash/config
mkdir -p /etc/routerclash/proxy_provider
mkdir -p /etc/routerclash/rule_provider
mkdir -p /etc/routerclash/core
mkdir -p /etc/routerclash/history
mkdir -p /usr/share/routerclash/backup/overwrite

#move the dynamic sections written by older builds (separate storage directory) into the
#main configuration, and drop the section types that no longer exist
if [ -f /etc/routerclash/uci/routerclash ]; then
	cp -f /etc/config/routerclash /tmp/routerclash.config.before_merge 2>/dev/null
	awk -v keep=1 '/^config /{ keep = ($2 != "groups" && $2 != "proxy-provider" && $2 != "servers") } keep' /etc/config/routerclash > /tmp/routerclash.merged 2>/dev/null
	echo >> /tmp/routerclash.merged
	cat /etc/routerclash/uci/routerclash >> /tmp/routerclash.merged
	if /sbin/uci -q -f /tmp/routerclash.merged import routerclash && /sbin/uci -q commit routerclash; then
		rm -rf /etc/routerclash/uci
	fi
	rm -f /tmp/routerclash.merged
fi

mkdir -p /lib/upgrade/keep.d
cat > "/lib/upgrade/keep.d/luci-app-routerclash" <<-EOF
/etc/routerclash/
EOF

#Set Chnroute Format
FW4=$(command -v fw4)
if [ -n "$FW4" ]; then
	#v4
	if [ -z "$(cat "/etc/routerclash/china_ip_route.ipset" |grep "define china_ip_route")" ]; then
		echo "define china_ip_route = {" >/tmp/china_ip_route.list
		awk '!/^$/&&!/^#/{printf("    %s,'" "'\n",$0)}' /etc/routerclash/china_ip_route.ipset >>/tmp/china_ip_route.list
		echo "}" >>/tmp/china_ip_route.list
		echo "add set inet fw4 china_ip_route { type ipv4_addr; flags interval; auto-merge; }" >>/tmp/china_ip_route.list
		echo 'add element inet fw4 china_ip_route $china_ip_route' >>/tmp/china_ip_route.list
	fi
	#v6
	if [ -z "$(cat "/etc/routerclash/china_ip6_route.ipset" |grep "define china_ip6_route")" ]; then
		echo "define china_ip6_route = {" >/tmp/china_ip6_route.list
		awk '!/^$/&&!/^#/{printf("    %s,'" "'\n",$0)}' /etc/routerclash/china_ip6_route.ipset >>/tmp/china_ip6_route.list
		echo "}" >>/tmp/china_ip6_route.list
		echo "add set inet fw4 china_ip6_route { type ipv6_addr; flags interval; auto-merge; }" >>/tmp/china_ip6_route.list
		echo 'add element inet fw4 china_ip6_route $china_ip6_route' >>/tmp/china_ip6_route.list
	fi
else
	#v4
	if [ -z "$(cat "/etc/routerclash/china_ip_route.ipset" |grep "create china_ip_route")" ]; then
		echo "create china_ip_route hash:net family inet hashsize 1024 maxelem 1000000" >/tmp/china_ip_route.list
		awk '!/^$/&&!/^#/{printf("add china_ip_route %s'" "'\n",$0)}' /etc/routerclash/china_ip_route.ipset >>/tmp/china_ip_route.list
	fi
	#v6
	if [ -z "$(cat "/etc/routerclash/china_ip6_route.ipset" |grep "create china_ip6_route")" ]; then
		echo "create china_ip6_route hash:net family inet6 hashsize 1024 maxelem 1000000" >/tmp/china_ip6_route.list
		awk '!/^$/&&!/^#/{printf("add china_ip6_route %s'" "'\n",$0)}' /etc/routerclash/china_ip6_route.ipset >>/tmp/china_ip6_route.list
	fi
fi
mv -f /tmp/china_ip_route.list /etc/routerclash/china_ip_route.ipset >/dev/null 2>&1
mv -f /tmp/china_ip6_route.list /etc/routerclash/china_ip6_route.ipset >/dev/null 2>&1

#Set Dashboard Secret
if [ -z "$(uci_get_config "dashboard_password")" ]; then
	uci -q set routerclash.config.dashboard_password="$(tr -cd 'a-zA-Z0-9' </dev/urandom 2>/dev/null| head -c8 || date +%N| md5sum |head -c8)"
fi

#Set Authentication
if [ -z "$(uci -q get routerclash.@authentication[0])" ]; then
	uci_name_tmp=$(uci -q add routerclash authentication)
	uci_set="uci -q set routerclash.$uci_name_tmp."
	${uci_set}enabled="1"
	${uci_set}username="Clash"
	${uci_set}password="$(tr -cd 'a-zA-Z0-9' </dev/urandom 2>/dev/null| head -c8 || date +%N| md5sum |head -c8)"
fi

#Set Core Model
source "/etc/openwrt_release"
case "${DISTRIB_ARCH}" in
	aarch64_*)
		CORE_ARCH="linux-arm64"
		;;
	armeb_*)
		CORE_ARCH="0"
		;;
	arm_cortex-a5|arm_cortex-a5[^0-9]*|arm_cortex-a7|arm_cortex-a7[^0-9]*|arm_cortex-a8*|arm_cortex-a9*|arm_cortex-a12*|arm_cortex-a15*|arm_cortex-a17*)
		CORE_ARCH="linux-armv7"
		;;
	arm_arm1176jzf-s*|arm_arm1136*|arm_mpcore*)
		CORE_ARCH="linux-armv6"
		;;
	arm*)
		CORE_ARCH="linux-armv5"
		;;
	i386_*)
		CORE_ARCH="linux-386"
		;;
	mips64el_*)
		CORE_ARCH="linux-mips64le"
		;;
	mips64_*)
		CORE_ARCH="linux-mips64"
		;;
	mips_*)
		CORE_ARCH="linux-mips-softfloat"
		;;
	mipsel_*)
		CORE_ARCH="linux-mipsle-softfloat"
		;;
	riscv64*)
		CORE_ARCH="linux-riscv64"
		;;
	loongarch64*|loongarch_*)
		CORE_ARCH="linux-loong64-abi2"
		;;
	x86_64)
		CORE_ARCH="linux-amd64-v1"
		;;
	*)
		CORE_ARCH="0"
		;;
esac
uci -q set routerclash.config.core_version="${CORE_ARCH}"

#Backup Resolvfile
if [ -n "$(uci -q get dhcp.@dnsmasq[0].resolvfile)" ]; then
	uci -q set routerclash.config.default_resolvfile=$(uci -q get dhcp.@dnsmasq[0].resolvfile)
fi

# Quic-go GSO Disable
current_kernel=$(uname -r | cut -d'-' -f1)
if [ "$(printf '%s\n' "$current_kernel" "6.6" | sort -V | head -n1)" != "$current_kernel" ]; then
	uci -q set routerclash.config.disable_quic_go_gso=1
fi

uci -q commit routerclash

#Backup
cp -f "/etc/config/routerclash" "/usr/share/routerclash/backup/routerclash" >/dev/null 2>&1
cp -f "/etc/routerclash/custom/routerclash_custom_rules.list" "/usr/share/routerclash/backup/routerclash_custom_rules.list" >/dev/null 2>&1
cp -f "/etc/routerclash/custom/routerclash_custom_rules_2.list" "/usr/share/routerclash/backup/routerclash_custom_rules_2.list" >/dev/null 2>&1
cp -f "/etc/routerclash/custom/routerclash_custom_hosts.list" "/usr/share/routerclash/backup/routerclash_custom_hosts.list" >/dev/null 2>&1
cp -f "/etc/routerclash/custom/routerclash_custom_fake_filter.list" "/usr/share/routerclash/backup/routerclash_custom_fake_filter.list" >/dev/null 2>&1
cp -f "/etc/routerclash/custom/routerclash_custom_domain_dns.list" "/usr/share/routerclash/backup/routerclash_custom_domain_dns.list" >/dev/null 2>&1
cp -f "/etc/routerclash/custom/routerclash_custom_domain_dns_policy.list" "/usr/share/routerclash/backup/routerclash_custom_domain_dns_policy.list" >/dev/null 2>&1
cp -f "/etc/routerclash/custom/routerclash_custom_proxy_server_dns_policy.list" "/usr/share/routerclash/backup/routerclash_custom_proxy_server_dns_policy.list" >/dev/null 2>&1
cp -f "/etc/routerclash/custom/routerclash_custom_fallback_filter.yaml" "/usr/share/routerclash/backup/routerclash_custom_fallback_filter.yaml" >/dev/null 2>&1
cp -f "/etc/routerclash/custom/routerclash_custom_sniffer.yaml" "/usr/share/routerclash/backup/routerclash_custom_sniffer.yaml" >/dev/null 2>&1
cp -f "/etc/routerclash/custom/routerclash_custom_localnetwork_ipv4.list" "/usr/share/routerclash/backup/routerclash_custom_localnetwork_ipv4.list" >/dev/null 2>&1
cp -f "/etc/routerclash/custom/routerclash_custom_localnetwork_ipv6.list" "/usr/share/routerclash/backup/routerclash_custom_localnetwork_ipv6.list" >/dev/null 2>&1
cp -f "/etc/routerclash/custom/routerclash_custom_chnroute_pass.list" "/usr/share/routerclash/backup/routerclash_custom_chnroute_pass.list" >/dev/null 2>&1
cp -f "/etc/routerclash/custom/routerclash_custom_chnroute6_pass.list" "/usr/share/routerclash/backup/routerclash_custom_chnroute6_pass.list" >/dev/null 2>&1
cp -f "/etc/routerclash/custom/routerclash_custom_firewall_rules.sh" "/usr/share/routerclash/backup/routerclash_custom_firewall_rules.sh" >/dev/null 2>&1
cp -f "/etc/routerclash/custom/routerclash_custom_overwrite.sh" "/usr/share/routerclash/backup/routerclash_custom_overwrite.sh" >/dev/null 2>&1
cp -f "/etc/routerclash/china_ip_route.ipset" "/usr/share/routerclash/backup/china_ip_route.ipset" >/dev/null 2>&1
cp -f "/etc/routerclash/china_ip6_route.ipset" "/usr/share/routerclash/backup/china_ip6_route.ipset" >/dev/null 2>&1
cp -f "/etc/routerclash/overwrite/default" "/usr/share/routerclash/backup/overwrite/default" >/dev/null 2>&1
cp -f "/etc/routerclash/rule_provider/rc-cn-domain.mrs" "/usr/share/routerclash/backup/rc-cn-domain.mrs" >/dev/null 2>&1

#Restore
RC_UPGRADE_DIR="/etc/.routerclash-upgrade"
if [ -f "$RC_UPGRADE_DIR/config" ]; then
	#keep the chnroute lists shipped by this package when the saved ones have the wrong format
	if [ -n "$FW4" ]; then
		grep -q "define china_ip_route" "$RC_UPGRADE_DIR/routerclash/china_ip_route.ipset" 2>/dev/null || rm -f "$RC_UPGRADE_DIR/routerclash/china_ip_route.ipset" "$RC_UPGRADE_DIR/routerclash/china_ip6_route.ipset" >/dev/null 2>&1
	else
		grep -q "create china_ip_route" "$RC_UPGRADE_DIR/routerclash/china_ip_route.ipset" 2>/dev/null || rm -f "$RC_UPGRADE_DIR/routerclash/china_ip_route.ipset" "$RC_UPGRADE_DIR/routerclash/china_ip6_route.ipset" >/dev/null 2>&1
	fi
	cp -f "$RC_UPGRADE_DIR/config" "/etc/config/routerclash" >/dev/null 2>&1
	cp -rf "$RC_UPGRADE_DIR/routerclash/." "/etc/routerclash/" >/dev/null 2>&1
	if [ -d "$RC_UPGRADE_DIR/ui/metacubexd" ] || [ -d "$RC_UPGRADE_DIR/ui/zashboard" ]; then
		rm -rf "/usr/share/routerclash/ui/" >/dev/null 2>&1
		cp -rf "$RC_UPGRADE_DIR/ui/." "/usr/share/routerclash/ui/" >/dev/null 2>&1
	fi
	if [ -f "/usr/share/routerclash/backup/rc-cn-domain.mrs" ]; then
		cp -f "/usr/share/routerclash/backup/rc-cn-domain.mrs" "/etc/routerclash/rule_provider/rc-cn-domain.mrs" >/dev/null 2>&1
	fi
	rm -rf "$RC_UPGRADE_DIR" >/dev/null 2>&1
fi

#Kill switch: on unless it was explicitly turned off. A core that is already running
#stays reachable, otherwise the next firewall reload would block a healthy proxy.
[ -n "$(uci -q get routerclash.config.kill_switch)" ] || uci -q set routerclash.config.kill_switch=1
[ -n "$(pidof clash)" ] && { mkdir -p /var/run; echo open > /var/run/routerclash_ks.state; }

#zashboard replaced metacubexd as the default panel
case "$(uci -q get routerclash.config.default_dashboard)" in
	""|metacubexd) uci -q set routerclash.config.default_dashboard=zashboard ;;
esac

#Settings dropped by the trimmed build
uci -q set routerclash.config.enable_redirect_dns=2
[ "$(uci_get_config "log_level")" = "0" ] && uci -q set routerclash.config.log_level=warning
uci -q commit routerclash

#long-running requests (streaming log)
#uhttpd backend (older LuCI)
if [ -x /etc/init.d/uhttpd ]; then
	uci -q set uhttpd.@uhttpd[0].max_requests=50
	uci -q set uhttpd.@uhttpd[0].script_timeout=3600
	uci -q commit uhttpd
fi
#nginx backend (luci-nginx, newer LuCI)
#gzip_types: nginx only compresses text/html by default, so the routerclash
#static assets (js/css/svg) and the JSON API answers are sent uncompressed
if [ -d /etc/nginx/conf.d ]; then
	UWSGI_TIMEOUT="uwsgi_read_timeout 3600;"
	GZIP_TYPES="gzip_types text/css application/javascript image/svg+xml application/json;"
	nginx -V 2>&1 | grep -q 'without-http_uwsgi_module' && UWSGI_TIMEOUT=""
	nginx -V 2>&1 | grep -q 'without-http_gzip_module' && GZIP_TYPES=""
	cat > /etc/nginx/conf.d/routerclash.conf <<-EOF
	$UWSGI_TIMEOUT
	$GZIP_TYPES
	EOF
	#same-origin proxy for the dashboard API so https pages can use wss
	[ -x /usr/share/routerclash/routerclash_nginx.sh ] && /usr/share/routerclash/routerclash_nginx.sh -n
fi

[ -x /etc/init.d/uhttpd ] && /etc/init.d/uhttpd restart >/dev/null 2>&1
[ -x /etc/init.d/nginx ] && /etc/init.d/nginx reload >/dev/null 2>&1

rm -rf /tmp/luci-indexcache /tmp/luci-indexcache.* /var/luci-indexcache /var/luci-indexcache.* >/dev/null 2>&1
rm -rf /tmp/luci-modulecache /var/luci-modulecache >/dev/null 2>&1
exit 0
